APP_ENV=development
DATABASE_URL=sqlite:///./data/crab.db
DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set a random secret to enable reviewer endpoints. Never commit a real key.
ADMIN_API_KEY=
# Optional validated ONNX bundle; without it, all predictions abstain.
MODEL_MANIFEST=
# Required in production; ClamAV must be reachable on a private network.
CLAMAV_HOST=
CLAMAV_PORT=3310
